# ---------------------------------------------------------------------------
# Tsara Café — variables d'environnement (exemple)
# Copiez ce fichier : cp .env.example .env
# Sur Vercel : Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Persistance des commandes (Upstash Redis) -----------------------------
# Sans ces variables, le projet retombe sur data/orders.json (local uniquement :
# le système de fichiers est en lecture seule sur Vercel).
# Console Upstash → votre base → REST API (« UPSTASH_REDIS_REST_URL » / « TOKEN »).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Mot de passe des actions admin ----------------------------------------
# Protège DELETE /api/orders, POST /api/orders/demo et PATCH .../status
# (HTTP Basic, login vide).
# Non défini = toutes les actions admin sont REFUSÉES (fail-closed).
ADMIN_PASSWORD=tsara-demo
